// ========== Config pines (exactamente los tuyos) ==========
#define LED1 77       // LED controlado por SWITCH_PIN (forzado por el switch)
#define LED2 76       // LED secuencia
#define LED3 75       // LED secuencia
#define LED4 74       // LED controlado por BUTTON_PIN (encendido mientras se pulsa)

#define SWITCH_PIN 79 // Switch de 2 posiciones: nivel 1 o 0 (forza LED1)
#define BUTTON_PIN 78 // Botón momentáneo: mientras esté pulsado -> LED4 ON

// OLED SPI pins (bit-bang)
#define OLED_RES 10   // RESET
#define OLED_DC  83   // D/C (0 = command, 1 = data)
#define OLED_SCLK 13  // SCLK
#define OLED_SDIN 11  // MOSI (SDIN)
// VDD = 82, VBAT = 84  -> ADVERTENCIA: no conectes VDD/VBAT a GPIO a menos que estés seguro.

#define STEP_DELAY 500  // ms secuencia

